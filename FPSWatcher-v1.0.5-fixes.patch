diff -ruN src/FPSWatcher-Next-v1.0.4/BUILD_WINDOWS.bat fixed/BUILD_WINDOWS.bat
--- src/FPSWatcher-Next-v1.0.4/BUILD_WINDOWS.bat	1970-01-01 00:00:00.000000000 +0000
+++ fixed/BUILD_WINDOWS.bat	2026-07-25 21:38:18.623808371 +0000
@@ -0,0 +1,83 @@
+@echo off
+setlocal EnableExtensions
+cd /d "%~dp0"
+title FPSWatcher v1.0.5 Build
+
+echo ==================================================
+echo   FPSWatcher Next v1.0.5 - Windows Debug Builder
+echo ==================================================
+echo.
+
+where flutter >nul 2>nul
+if errorlevel 1 (
+  echo [ERROR] Flutter was not found in PATH.
+  echo Install Flutter 3.44.7 or newer, then reopen this window.
+  pause
+  exit /b 1
+)
+
+where git >nul 2>nul
+if errorlevel 1 (
+  echo [ERROR] Git was not found in PATH.
+  pause
+  exit /b 1
+)
+
+where cargo >nul 2>nul
+if errorlevel 1 (
+  echo [ERROR] Rust/Cargo was not found in PATH.
+  echo Install Rust from rustup before building the full Flutter + Rust APK.
+  pause
+  exit /b 1
+)
+
+echo [1/7] Checking Flutter...
+call flutter doctor -v
+if errorlevel 1 goto :failed
+
+echo.
+echo [2/7] Generating Android host project...
+powershell -NoProfile -ExecutionPolicy Bypass -File ".\tool\bootstrap_android.ps1"
+if errorlevel 1 goto :failed
+
+echo.
+echo [3/7] Fetching Flutter packages...
+call flutter pub get
+if errorlevel 1 goto :failed
+
+echo.
+echo [4/7] Generating launcher icons...
+call dart run flutter_launcher_icons
+if errorlevel 1 goto :failed
+
+echo.
+echo [5/7] Building Rust Android libraries...
+powershell -NoProfile -ExecutionPolicy Bypass -File ".\tool\build_rust.ps1"
+if errorlevel 1 goto :failed
+
+echo.
+echo [6/7] Running checks...
+call flutter analyze
+if errorlevel 1 goto :failed
+call flutter test
+if errorlevel 1 goto :failed
+
+echo.
+echo [7/7] Building debug APK...
+call flutter build apk --debug
+if errorlevel 1 goto :failed
+
+if not exist "dist" mkdir "dist"
+copy /Y "build\app\outputs\flutter-apk\app-debug.apk" "dist\FPSWatcher-Next-v1.0.5-debug.apk" >nul
+
+echo.
+echo [OK] APK created:
+echo %CD%\dist\FPSWatcher-Next-v1.0.5-debug.apk
+pause
+exit /b 0
+
+:failed
+echo.
+echo [ERROR] Build failed. The first error above is the useful one.
+pause
+exit /b 1
diff -ruN src/FPSWatcher-Next-v1.0.4/CHANGELOG.md fixed/CHANGELOG.md
--- src/FPSWatcher-Next-v1.0.4/CHANGELOG.md	2026-07-25 20:40:47.000000000 +0000
+++ fixed/CHANGELOG.md	2026-07-25 21:37:27.815809473 +0000
@@ -1,5 +1,17 @@
 # Changelog
 
+## 1.0.5
+
+- Fixed Android 17 display collection by resolving the default display through `DisplayManager` instead of reading `Context.display` from an application context.
+- Isolated every metric so a single vendor/API failure no longer stops the full telemetry snapshot.
+- Added operational Shizuku UserService checks and automatic Shizuku → root → standard fallback.
+- Added SukiSU/KernelSU-compatible `su -c` probing and truthful root status reporting.
+- Added Usage Access, Shizuku and root foreground-app fallbacks.
+- Expanded universal Adreno, Mali, PowerVR and MediaTek GPU node discovery.
+- Fixed dashboard card overflows and removed raw platform exceptions from the main UI.
+- Added charging/current/voltage fields to live telemetry and CSV exports.
+- Hides the floating overlay over FPSWatcher and Android permission/settings screens.
+
 ## 1.0.4
 
 - Enabled Android `BuildConfig` generation in the app module so `ShizukuClient` can read `BuildConfig.DEBUG` under AGP 9.
diff -ruN src/FPSWatcher-Next-v1.0.4/GITHUB_DESKTOP_TR.txt fixed/GITHUB_DESKTOP_TR.txt
--- src/FPSWatcher-Next-v1.0.4/GITHUB_DESKTOP_TR.txt	1970-01-01 00:00:00.000000000 +0000
+++ fixed/GITHUB_DESKTOP_TR.txt	2026-07-25 21:38:18.623808371 +0000
@@ -0,0 +1,13 @@
+FPSWatcher Next v1.0.5 - GitHub Desktop
+======================================
+
+1. ZIP dosyasını kısa bir klasöre çıkartın. Örnek: C:\Projects\FPSWatcher
+2. GitHub Desktop'ı açın.
+3. File > Add local repository seçeneğine girin.
+4. Çıkarttığınız FPSWatcher klasörünü seçin.
+5. "create a repository" bağlantısı görünürse tıklayın ve ana dalı main olarak oluşturun.
+6. Publish repository ile GitHub'a gönderin.
+7. Push tamamlandığında .github/workflows/android.yml otomatik olarak debug ve release APK üretir.
+8. GitHub > Actions > son Android Build > Artifacts > FPSWatcher-Android bölümünden APK'ları indirin.
+
+Bilgisayarda doğrudan APK üretmek için BUILD_WINDOWS.bat dosyasına çift tıklayın.
